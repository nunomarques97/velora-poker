{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "velora-poker",
  "version": "0.1.0",
  "identifier": "com.velora.poker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Velora Poker",
        "width": 800,
        "height": 600
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "Velora Overlay",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": true,
        "width": 1400,
        "height": 900,
        "x": 80,
        "y": 80,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
